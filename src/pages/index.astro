          </div>
          <div class="form-group">
            <label for="project_domain">Primary Domain</label>
            <select id="project_domain" name="project_domain" class="form-control" autocomplete="off">
              <option value="web-dev-design">Web Dev Design (Performance, Full-Stack, UI/UX)</option>
              <option value="seo">SEO (Programmatic, Technical Audit, GEO/AEO)</option>
              <option value="writer">Writer (Pitch Decks, Business Feasibility, Research)</option>
              <option value="data-analysis">Data Analysis (Mathematical Modeling, Automation, Stats)</option>

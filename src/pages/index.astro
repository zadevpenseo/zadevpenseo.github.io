      <form id="inquiryForm" class="lead-form">
        <div class="lead-form-grid">
          <div class="form-group">
            <label for="client_name">Your Name / Organization</label>
            <input type="text" id="client_name" name="client_name" class="form-control" placeholder="e.g. Alex Rivera (Venture Lead)" autocomplete="name" required />

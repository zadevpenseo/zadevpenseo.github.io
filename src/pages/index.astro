          </div>
        </div>

        <div class="form-group" style="margin-bottom: 1.5rem;">
          <label for="project_scope">Core Bottleneck, Deliverable Scope, or Technical Challenge</label>
          <textarea id="project_scope" name="project_scope" rows="4" class="form-control" placeholder="Describe the engineering challenge, tech stack, deliverables, or target timeline..." required></textarea>
        </div>

        <button type="submit" class="btn-primary" style="border: none; cursor: pointer;">

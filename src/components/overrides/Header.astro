---
/**
 * src/components/overrides/Header.astro
 * TasteSkill brand-consistent navigation header for all Starlight pages.
 * Matches the homepage nav exactly: ZADIT logo, 4-pillar links, CTA, hamburger mobile.
 */
import Search from 'virtual:starlight/components/Search';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
---

<div class="header sl-flex">
  <!-- Left: Wordmark -->
  <div class="title-wrapper sl-flex">
    <a href="/" class="zd-logo" aria-label="Zadit - Home">
      ZADIT
      <span class="zd-logo-badge">SYSTEMS &amp; BLUEPRINTS</span>
    </a>
  </div>

  <!-- Center: Search (Starlight built-in Pagefind) -->
  <div class="sl-flex zd-search-wrap print:hidden">
    <Search />
  </div>

  <!-- Right: Nav links + CTA + ThemeSelect -->
  <div class="sl-hidden md:sl-flex print:hidden zd-right-group" id="zdNavLinks">
    <nav class="zd-nav-links" aria-label="Main navigation">
      <a href="/case-studies/" data-nav-route="/case-studies/">Hub</a>
      <a href="/#demos" data-nav-route="/#demos">Live Demos</a>
      <a href="/case-studies/web-dev-design/" data-nav-route="/case-studies/web-dev-design/">Web Dev</a>
      <a href="/case-studies/seo/" data-nav-route="/case-studies/seo/">SEO</a>
      <a href="/case-studies/writer/" data-nav-route="/case-studies/writer/">Writer</a>
      <a href="/case-studies/data-analysis/" data-nav-route="/case-studies/data-analysis/">Data Analysis</a>
    </nav>
    <a href="/#inquiry" class="zd-btn-nav">Initiate Project</a>
    <ThemeSelect />
    <a 
      href="https://github.com/zadevpenseo/zadevpenseo.github.io" 
      target="_blank" 
      rel="noopener noreferrer" 
      class="zd-github-btn" 
      aria-label="View source repository on GitHub" 
      title="GitHub Repository: zadevpenseo/zadevpenseo.github.io"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" width="19" height="19" fill="currentColor">
        <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
      </svg>
    </a>
  </div>

  <!-- Mobile actions: ThemeSelect + animated hamburger toggle -->
  <div class="sl-flex md:sl-hidden print:hidden zd-mobile-actions">
    <ThemeSelect />
    <button
      class="zd-nav-toggle"
      id="zdNavToggle"
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="zdMobileNav"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</div>

<!-- Mobile nav dropdown (injected after header row) -->
<div id="zdMobileNav" class="zd-mobile-nav" hidden>
  <a href="/case-studies/" data-nav-route="/case-studies/">Case Studies Hub</a>
  <a href="/#demos" data-nav-route="/#demos">Live Interactive Demos</a>
  <a href="/case-studies/web-dev-design/" data-nav-route="/case-studies/web-dev-design/">Web Dev Design</a>
  <a href="/case-studies/seo/" data-nav-route="/case-studies/seo/">SEO</a>
  <a href="/case-studies/writer/" data-nav-route="/case-studies/writer/">Writer</a>
  <a href="/case-studies/data-analysis/" data-nav-route="/case-studies/data-analysis/">Data Analysis</a>
  <a href="https://github.com/zadevpenseo/zadevpenseo.github.io" target="_blank" rel="noopener noreferrer">GitHub Repository ↗</a>
  <a href="/#inquiry" class="zd-mobile-cta">Initiate Project →</a>
</div>

<script>
  const toggle = document.getElementById('zdNavToggle');
  const mobileNav = document.getElementById('zdMobileNav');
  if (toggle && mobileNav) {
    toggle.addEventListener('click', () => {
      const isOpen = !mobileNav.hasAttribute('hidden');
      if (isOpen) {
        mobileNav.setAttribute('hidden', '');
        toggle.setAttribute('aria-expanded', 'false');
      } else {
        mobileNav.removeAttribute('hidden');
        toggle.setAttribute('aria-expanded', 'true');
      }
    });
    mobileNav.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileNav.setAttribute('hidden', '');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  }

  // Active route highlighting
  const currentPath = window.location.pathname;
  document.querySelectorAll('.zd-nav-links a, .zd-mobile-nav a').forEach(link => {
    const route = link.getAttribute('data-nav-route');
    if (route && route !== '/#demos') {
      if (route === '/case-studies/' && currentPath === '/case-studies/') {
        link.setAttribute('aria-current', 'page');
      } else if (route !== '/case-studies/' && currentPath.startsWith(route)) {
        link.setAttribute('aria-current', 'page');
      }
    }
  });

  // Ensure dynamic search inputs from Pagefind have explicit id and name attributes
  const ensureInputAttrs = () => {
    const inputs = document.querySelectorAll('.pagefind-ui__search-input');
    inputs.forEach(input => {
      if (!input.hasAttribute('id')) input.setAttribute('id', 'pagefind-search-input');
      if (!input.hasAttribute('name')) input.setAttribute('name', 'search_query');
    });
    return inputs.length > 0;
  };
  if (!ensureInputAttrs()) {
    const searchObserver = new MutationObserver((_, observer) => {
      if (ensureInputAttrs()) {
        observer.disconnect();
      }
    });
    searchObserver.observe(document.body, { childList: true, subtree: true });
  }
</script>

<style>
  /* ─── Header layout (mirrors Starlight internals) ─── */
  .header {
    gap: var(--sl-nav-gap);
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }

  .title-wrapper {
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
    flex-shrink: 0;
  }

  /* ─── Wordmark ─── */
  .zd-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: 0.05em;
    color: var(--zd-primary-navy);
    text-decoration: none;
    white-space: nowrap;
    font-family: var(--zd-font-sans);
    transition: color var(--zd-duration-fast);
  }
  :root[data-theme='dark'] .zd-logo {
    color: var(--zd-text-primary);
  }
  .zd-logo:hover {
    color: var(--zd-primary-blue);
  }

  .zd-logo-badge {
    font-size: 0.62rem;
    padding: 0.16rem 0.5rem;
    border-radius: 9999px;
    background: #eff6ff;
    border: 1px solid #dbeafe;
    color: var(--zd-primary-blue);
    font-family: var(--zd-font-mono);
    letter-spacing: 0.06em;
    font-weight: 600;
  }
  :root[data-theme='dark'] .zd-logo-badge {
    background: rgba(59, 130, 246, 0.15);
    border-color: rgba(59, 130, 246, 0.3);
    color: #93c5fd;
  }

  /* ─── Search wrap ─── */
  .zd-search-wrap {
    flex: 1;
    max-width: 340px;
  }

  /* ─── Right nav group ─── */
  .zd-right-group {
    align-items: center;
    gap: 1.25rem;
  }

  .zd-nav-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .zd-nav-links a {
    font-size: 0.87rem;
    font-weight: 600;
    color: var(--zd-text-secondary);
    text-decoration: none;
    transition: color var(--zd-duration-fast);
    font-family: var(--zd-font-sans);
  }
  .zd-nav-links a:hover {
    color: var(--zd-primary-navy);
  }
  :root[data-theme='dark'] .zd-nav-links a:hover {
    color: var(--zd-primary-blue);
  }
  .zd-nav-links a[aria-current="page"] {
    color: var(--zd-primary-navy);
    position: relative;
  }
  :root[data-theme='dark'] .zd-nav-links a[aria-current="page"] {
    color: var(--zd-primary-blue);
  }
  .zd-nav-links a[aria-current="page"]::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 15%;
    right: 15%;
    height: 2px;
    background: var(--zd-primary-navy);
    border-radius: 2px;
  }
  :root[data-theme='dark'] .zd-nav-links a[aria-current="page"]::after {
    background: var(--zd-primary-blue);
  }

  /* ─── CTA Button ─── */
  .zd-btn-nav {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 1rem;
    border-radius: var(--zd-radius-md);
    background: var(--zd-primary-navy);
    color: #ffffff !important;
    font-weight: 600;
    font-size: 0.84rem;
    text-decoration: none !important;
    transition: all var(--zd-duration-base);
    white-space: nowrap;
    font-family: var(--zd-font-sans);
  }
  .zd-btn-nav:hover {
    background: #1e40af;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(30, 58, 138, 0.2);
  }
  :root[data-theme='dark'] .zd-btn-nav {
    background: var(--zd-primary-navy);
    color: #ffffff !important;
  }

  /* ─── GitHub Icon Button ─── */
  .zd-github-btn {
    background: var(--zd-bg-card);
    border: 1px solid var(--zd-border-subtle);
    color: var(--zd-text-secondary);
    width: 36px;
    height: 36px;
    border-radius: var(--zd-radius-md);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none !important;
    transition: all var(--zd-duration-fast);
    flex-shrink: 0;
  }
  .zd-github-btn:hover {
    border-color: var(--zd-primary-blue);
    color: var(--zd-primary-navy);
    transform: translateY(-1px);
    box-shadow: var(--zd-shadow-card);
  }
  :root[data-theme='dark'] .zd-github-btn:hover {
    color: var(--zd-primary-blue);
  }

  /* ─── Mobile Actions Cluster (ThemeSelect + Hamburger) ─── */
  .zd-mobile-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  /* ─── Hamburger Toggle ─── */
  .zd-nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    background: transparent;
    border: 1px solid var(--zd-border-subtle);
    border-radius: var(--zd-radius-md);
    cursor: pointer;
    width: 42px;
    height: 42px;
    min-width: 42px;
    min-height: 42px;
    padding: 0;
    transition: all var(--zd-duration-fast);
  }
  .zd-nav-toggle:hover {
    border-color: var(--zd-primary-blue);
    box-shadow: var(--zd-shadow-card);
  }
  .zd-nav-toggle:active {
    transform: translateY(1px) scale(0.96);
  }
  .zd-nav-toggle span {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--zd-text-primary);
    border-radius: 2px;
    transition: transform var(--zd-duration-base) var(--zd-ease-spring), opacity var(--zd-duration-base) var(--zd-ease-spring);
    transform-origin: center;
  }
  .zd-nav-toggle[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .zd-nav-toggle[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .zd-nav-toggle[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ─── Mobile nav dropdown ─── */
  .zd-mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0;
    position: fixed;
    top: var(--sl-nav-height);
    left: 0;
    right: 0;
    background: var(--zd-bg-glass);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--zd-border-subtle);
    padding: 1rem 1.5rem;
    z-index: 200;
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.08);
  }
  .zd-mobile-nav[hidden] { display: none; }
  .zd-mobile-nav a {
    padding: 0.75rem 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--zd-text-secondary);
    text-decoration: none;
    border-bottom: 1px solid var(--zd-border-subtle);
    font-family: var(--zd-font-sans);
    transition: color var(--zd-duration-fast);
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .zd-mobile-nav a:hover { color: var(--zd-primary-navy); }
  :root[data-theme='dark'] .zd-mobile-nav a:hover { color: var(--zd-primary-blue); }
  .zd-mobile-nav a:last-child { border-bottom: none; }
  .zd-mobile-cta {
    color: var(--zd-primary-navy) !important;
    font-weight: 700 !important;
    margin-top: 0.5rem;
  }
  :root[data-theme='dark'] .zd-mobile-cta { color: var(--zd-primary-blue) !important; }

  /* ─── Responsive ─── */
  @media (max-width: 50rem) {
    .zd-nav-toggle { display: flex !important; }
    .zd-search-wrap { max-width: 180px; }
  }
  @media (max-width: 380px) {
    .zd-logo-badge { display: none; }
    .zd-search-wrap { max-width: 130px; }
  }

  @media (min-width: 50rem) {
    .header {
      --__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
      display: grid;
      grid-template-columns:
        minmax(auto, calc(var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x)))
        1fr
        auto;
      align-content: center;
    }
  }
</style>

---
/**
 * src/components/overrides/Footer.astro
 * TasteSkill brand-consistent footer for all Starlight pages.
 * Matches homepage footer: dark obsidian, Bronze Gold links, PT PRISMA attribution.
 */
---

<footer class="zd-footer">
  <div class="zd-footer-inner">
    <div class="zd-footer-brand">
      <a href="/" class="zd-footer-logo">ZADIT</a>
      <span class="zd-footer-sep">·</span>
      <span class="zd-footer-tagline">Web Dev Design · SEO · Writer · Data Analysis</span>
    </div>
    <div class="zd-footer-links">
      <a href="/case-studies/">Case Studies Hub</a>
      <a href="/case-studies/web-dev-design/">Web Dev</a>
      <a href="/case-studies/seo/">SEO</a>
      <a href="/case-studies/writer/">Writer</a>
      <a href="/case-studies/data-analysis/">Data Analysis</a>
      <a href="/#inquiry">Initiate Project</a>
    </div>
    <div class="zd-footer-legal">
      <p>
        &copy; 2026 <strong>Muhammad Khoiruzzadittaqwa (Zadit)</strong>. Published under <strong>PT PRISMA DIGITAL KREATIF</strong>.
      </p>
      <p class="zd-footer-meta">
        NIB: 1801250039976 &middot; TDPSE Kominfo: 017014.01/DJAI.PSE/01/2025 &middot; Cirebon, Indonesia
        &middot; <a href="https://orcid.org/0000-0002-1594-9548" target="_blank" rel="noopener">ORCID</a>
        &middot; <a href="https://www.wikidata.org/wiki/Q141474900" target="_blank" rel="noopener">Wikidata Q141474900</a>
        &middot; <a href="https://github.com/zadevpenseo" target="_blank" rel="noopener">GitHub</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .zd-footer {
    border-top: 1px solid var(--zd-border-subtle);
    background: var(--zd-bg-surface);
    padding: 3rem 0 2rem 0;
    margin-top: 4rem;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    transition: background-color var(--zd-duration-base);
  }

  .zd-footer-inner {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  .zd-footer-brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .zd-footer-logo {
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 0.05em;
    color: var(--zd-gold);
    text-decoration: none;
    transition: color var(--zd-duration-fast);
  }
  .zd-footer-logo:hover { color: var(--zd-gold-hover); }

  .zd-footer-sep {
    color: var(--zd-border);
    font-size: 0.9rem;
  }

  .zd-footer-tagline {
    font-size: 0.85rem;
    color: var(--zd-text-subtle);
    letter-spacing: 0.02em;
  }

  .zd-footer-links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.3rem 1.25rem;
  }

  .zd-footer-links a {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--zd-text-muted);
    text-decoration: none;
    transition: color var(--zd-duration-fast);
  }
  .zd-footer-links a:hover { color: var(--zd-gold); }

  .zd-footer-legal {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    border-top: 1px solid var(--zd-border-subtle);
    padding-top: 1.25rem;
    width: 100%;
  }

  .zd-footer-legal p {
    font-size: 0.82rem;
    color: var(--zd-text-muted);
    margin: 0;
  }
  .zd-footer-legal strong { color: var(--zd-text-secondary); }

  .zd-footer-meta {
    font-size: 0.76rem !important;
    color: var(--zd-text-ghost) !important;
  }
  .zd-footer-meta a {
    color: var(--zd-gold);
    text-decoration: none;
  }
  .zd-footer-meta a:hover { text-decoration: underline; }
</style>

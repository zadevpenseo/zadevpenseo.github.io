---
/**
 * src/components/overrides/PageTitle.astro
 * Styled page title for Starlight docs pages.
 * Renders the H1 with Academic Editorial Newsreader typography.
 */
const { title } = Astro.locals.starlightRoute.entry.data;
---

<div class="zd-page-title">
  <h1 id="_top">{title}</h1>
</div>

<style>
  .zd-page-title {
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--zd-border-subtle);
  }

  .zd-page-title h1 {
    font-size: clamp(2rem, 4.4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.2;
    color: var(--zd-text-primary);
    font-family: var(--zd-font-serif), Georgia, 'Times New Roman', serif;
    margin: 0;
  }
</style>

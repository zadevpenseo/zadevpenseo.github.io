---
/**
 * src/components/overrides/PageTitle.astro
 * Styled page title for Starlight docs pages.
 * Renders the H1 with TasteSkill typography + semantic token gradient.
 */
const { title } = Astro.locals.starlightRoute.entry.data;
---

<div class="zd-page-title">
  <h1 id="_top">{title}</h1>
</div>

<style>
  .zd-page-title {
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--zd-border);
  }

  .zd-page-title h1 {
    font-size: clamp(1.85rem, 4.2vw, 2.65rem);
    font-weight: 800;
    letter-spacing: -0.022em;
    line-height: 1.2;
    color: var(--zd-text-primary);
    font-family: var(--zd-font-sans);
    background: var(--zd-title-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0;
  }
</style>
